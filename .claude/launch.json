{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rafino",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m", "uvicorn", "src.api.main:app",
        "--host", "127.0.0.1", "--port", "8000"
      ],
      "port": 8000
    },
    {
      "name": "tanitim",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m", "http.server", "8080",
        "--directory", "tanitim", "--bind", "127.0.0.1"
      ],
      "port": 8080
    }
  ]
}
